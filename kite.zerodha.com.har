            "mimeType": "text/html",
            "text": "<!doctype html><html><head><meta charset=\"utf-8\"/><meta name=\"viewport\" content=\"user-scalable=no,width=device-width,initial-scale=1\"/><link href=\"https://fonts.googleapis.com/css?family=Open+Sans:300,400,600\" rel=\"preload\" as=\"style\"><script src=\"/static/chart/tradingview/datafeeds/polyfills.js\"></script><script src=\"/static/chart/tradingview/datafeeds/ServerDate.js\"></script><style>.tv-chart-in-iframe {\n\t\t\t\theight: 100%;\n\t\t\t\twidth: 100%;\n\t\t\t}\n\t\t\thtml {\n\t\t\t\theight: 100%;\n\t\t\t\twidth: 100%;\n\t\t\t}\n\t\t\tbody {\n\t\t\t\tfont-family: \"Open Sans\", sans-serif;\n\t\t\t\tmargin: 0;\n\t\t\t\tpadding: 0;\n\t\t\t\twidth: 100%;\n\t\t\t\theight: 100%;\n\t\t\t\t--color-text-default: #444;\n\t\t\t\t--color-border-5--rgb: 0, 0, 0;\n\t\t\t\t--color-bg-default: #fff;\n\t\t\t\t--color-bg-default--rgb: 255, 255, 255;\n\t\t\t\t--color-border-1: #f1f1f1;\n\t\t\t\t--color-bg-5: #4184f3;\n\t\t\t\t--color-border-2: #d9d9d9;\n\t\t\t}\n\n\t\t\tbody.dark-theme {\n\t\t\t\t--color-text-default: #bbb;\n\t\t\t\t--color-border-5--rgb: 35, 35, 37;\n\t\t\t\t--color-bg-default: #222;\n\t\t\t\t--color-bg-default--rgb: 24, 24, 24;\n\t\t\t\t--color-border-1: #2c2c2c;\n\t\t\t\t--color-bg-5: #4987ee;\n\t\t\t\t--color-border-2: #3d3d3c;\n\n\t\t\t}\n\n\t\t\t/** KITE MODAL STYLES START **/\n\t\t\t.kite-modal {\n\t\t\t\tfont-family: \"Open Sans\", sans-serif;\n\t\t\t\ttransition: all;\n\t\t\t\tborder: none;\n\t\t\t\tbox-shadow: 0 0 2px 0 rgba(var(--color-border-5--rgb), .2), 0 4px 10px 0 rgba(var(--color-border-5--rgb), .05);\n\t\t\t\tborder-radius: 4px;\n\t\t\t\tpadding: 25px;\n\t\t\t\tcolor: var(--color-text-default);\n\t\t\t\tbackground-color: var(--color-bg-default);\n\t\t\t}\n\t\t\t.kite-modal::backdrop {\n\t\t\t\tbackground: rgba(var(--color-bg-default--rgb), .7);\n\t\t\t}\n\t\t\t.kite-modal .modal-header {\n\t\t\t\tborder-bottom: 1px solid var(--color-border-1);\n\t\t\t\tpadding-bottom: 20px;\n\t\t\t\tfont-size: 21px;\n\t\t\t\tfont-weight: 600;\n\t\t\t}\n\t\t\t.kite-modal .modal-body {\n\t\t\t\tpadding: 30px 0;\n\t\t\t}\n\t\t\t.kite-modal .modal-footer {\n\t\t\t\tborder-top: 1px solid var(--color-border-1);\n\t\t\t\tpadding-top: 20px;\n\t\t\t\ttext-align: right;\n\t\t\t}\n\t\t\t.kite-modal button {\n\t\t\t\tcursor: pointer;\n\t\t\t\tmargin-left: 5px;\n\t\t\t\tborder-radius: 3px;\n\t\t\t\tpadding: 10px 20px;\n\t\t\t\tfont-size: .925rem;\n\t\t\t\tfont-weight: 400;\n\t\t\t\tline-height: 1;\n\t\t\t\tdisplay: inline-block;\n\t\t\t\toutline: none;\n\t\t\t\tbackground-color: var(--color-bg-default);\n\t\t\t\tcolor: var(--color-text-default);\n\t\t\t}\n\t\t\t.kite-modal .button-blue {\n\t\t\t\tcolor: #fff;\n\t\t\t\tbackground-color: var(--color-bg-5);\n\t\t\t\tborder: 1px solid var(--color-bg-5);\n\t\t\t}\n\t\t\t.kite-modal .button-blue:hover,\n\t\t\t.kite-modal .button-blue:focus {\n\t\t\t\topacity: .8;\n\t\t\t}\n\n\t\t\t.kite-modal .button-outline {\n\t\t\t\tborder: 1px solid var(--color-border-2);\n\t\t\t}\n\t\t\t.kite-modal .button-outline:hover{\n\t\t\t\tcolor: #fff;\n\t\t\t\tbackground-color: var(--color-border-2);\n\t\t\t}\n\t\t\t.kite-modal .button-outline:focus {\n\t\t\t\topacity: .9;\n\t\t\t}\n\t\t\t/** KITE MODAL STYLES END **/\n\n\t\t\t/** Chart spinner STYLES START :: TODO REMOVE after mobile supports multiple chart layout.**/\n\t\t\t#splash-screen {\n\t\t\t\ttop: 0;\n\t\t\t\tleft: 0;\n\t\t\t\tright: 0;\n\t\t\t\tbottom: 0;\n\t\t\t\ttext-align: center;\n\t\t\t\tposition: absolute;\n\t\t\t\tbackground-color: #FFFFFF;\n\t\t\t\tz-index: 9999;\n\t\t\t}\n\t\t\t.su-loader {\n\t\t\t\tdisplay: block;\n\t\t\t\tmargin-top: 15%;\n\t\t\t}\n\t\t\t.dot-spinner {\n\t\t\t\tmargin-left: 0;\n\t\t\t}\n\t\t\t.dot-spinner {\n\t\t\t\tmargin-left: 5px;\n\t\t\t\tdisplay: inline-block;\n\t\t\t}\n\t\t\t.dot-spinner i {\n\t\t\t\tdisplay: inline-block;\n\t\t\t\twidth: 6px;\n\t\t\t\theight: 6px;\n\t\t\t\tborder-radius: 50%;\n\t\t\t\tbackground-color: #444444;\n\t\t\t\tvertical-align: middle;\n\t\t\t}\n\t\t\t.dot-spinner i:first-child {\n\t\t\t\ttransform: translate(-5px);\n\t\t\t\tanimation: dot-spinner-ani2 .5s linear infinite;\n\t\t\t\topacity: 0;\n\t\t\t}\n\t\t\t.dot-spinner i:nth-child(2),\n\t\t\t.dot-spinner i:nth-child(3) {\n\t\t\t\tanimation: dot-spinner-ani3 .5s linear infinite;\n\t\t\t}\n\t\t\t.dot-spinner i:last-child {\n\t\t\t\tanimation: dot-spinner-ani1 .5s linear infinite;\n\t\t\t}\n\t\t\t@keyframes dot-spinner-ani1 {\n\t\t\t\t100% {\n\t\t\t\t\ttransform: translate(10px);\n\t\t\t\t\topacity: 0;\n\t\t\t\t}\n\t\t\t}\n\t\t\t@keyframes dot-spinner-ani2 {\n\t\t\t\t100% {\n\t\t\t\t\ttransform: translate(5px);\n\t\t\t\t\topacity: 1;\n\t\t\t\t}\n\t\t\t}\n\t\t\t@keyframes dot-spinner-ani3 {\n\t\t\t\t100% {\n\t\t\t\t\ttransform: translate(5px);\n\t\t\t\t}\n\t\t\t}\n\t\t\tbody.dark-theme #splash-screen {\n\t\t\t\tbackground-color:#181818;\n\t\t\t}\n\t\t\t/** Chart spinner STYLES END **/</style><script>// iframe ->(calls)-> mobile\n\t\t\t// 1. postMessage - to send message to native side\n\n\t\t\t// mobile ->(calls)-> iframe\n\t\t\t// 1. webViewCallResolve - to send success response to iframe\n\t\t\t// 2. webViewCallReject - to send failure response to iframe\n\t\t\tif(window.WebViewBridge) {\n\t\t\t\twindow.is_mobile = true;\n\n\t\t\t\tWebViewBridge.webViewCallCounter = 0\n\t\t\t\tWebViewBridge.webViewPromises = {}\n\t\t\t\t\n\t\t\t\tWebViewBridge.webViewCall = (funcName, args) => {\n\t\t\t\t\tlet p = new Promise(function(resolve, reject) {\n\t\t\t\t\t\tWebViewBridge.webViewPromises[WebViewBridge.webViewCallCounter] = {resolve, reject}\n\t\t\t\t\t\tlet requestJSON = JSON.stringify({id: WebViewBridge.webViewCallCounter, name: funcName, args: args})\n\t\t\t\t\t\tWebViewBridge.postMessage(requestJSON)\n\t\t\t\t\t\tWebViewBridge.webViewCallCounter++\n\t\t\t\t\t})\n\t\t\t\t\treturn p\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tWebViewBridge.webViewCallResolve = (callId, resultJSON) => {\n\t\t\t\t\tWebViewBridge.webViewPromises[callId].resolve(resultJSON)\n\t\t\t\t\tdelete WebViewBridge.webViewPromises[callId]\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tWebViewBridge.webViewCallReject = (callId, resultJSON) => {\n\t\t\t\t\tWebViewBridge.webViewPromises[callId].reject(resultJSON)\n\t\t\t\t\tdelete WebViewBridge.webViewPromises[callId]\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tWebViewBridge.savePreferences = (t,d) => {\n\t\t\t\t\treturn WebViewBridge.webViewCall(\"savePreferences\", [t,d])\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tWebViewBridge.getPreferences = (t) => {\n\t\t\t\t\treturn WebViewBridge.webViewCall(\"getPreferences\", [t])\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tWebViewBridge.deletePreferences = (t) => {\n\t\t\t\t\treturn WebViewBridge.webViewCall(\"deletePreferences\", [t])\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tWebViewBridge.getHistory = (a) => {\n\t\t\t\t\treturn WebViewBridge.webViewCall(\"getHistory\", [a])\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tWebViewBridge.getEvents = (a) => {\n\t\t\t\t\treturn WebViewBridge.webViewCall(\"getEvents\", [a])\n\t\t\t\t}\n\n\t\t\t\tWebViewBridge.getChartInstrument = (a) => {\n\t\t\t\t\treturn WebViewBridge.webViewCall(\"getChartInstrument\", [a])\n\t\t\t\t}\n\t\t\t\tWebViewBridge.showToast = (type, prompt) => {\n\t\t\t\t\treturn WebViewBridge.webViewCall(\"showToast\", [type, prompt])\n\t\t\t\t}\n\t\t\t}</script></head><body><dialog id=\"delete-pref-dialog\" class=\"kite-modal\" closedby=\"any\"><div class=\"modal-header\">Are you sure?</div><div class=\"modal-body\"><span>Clearing your preferences will delete all indicators and templates, do you want to continue?</span></div><div class=\"modal-footer\"><button id=\"confirm-delete-btn\" class=\"button-blue\">Yes</button><form style=\"display: inline-block; margin: 0;\"><button autofocus class=\"button-outline\" type=\"submit\" aria-label=\"close\" formmethod=\"dialog\" formnovalidate>No</button></form></div></dialog><div id=\"splash-screen\" style=\"display: none;\"><div class=\"su-loader\"><span class=\"dot-spinner\"><i></i><i></i><i></i><i></i></span></div></div><div class=\"tv-chart-in-iframe\" id=\"tv-chart-in-iframe\"></div><script src=\"/static/chart/tradingview/tvchart.js?v=3.7.12\"></script></body></html>"
