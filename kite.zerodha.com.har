            "text": ".button-PYEOTd6i{background-color:initial;box-sizing:border-box;cursor:default;border:none;border-radius:4px;flex:none;justify-content:center;align-items:center;width:20px;height:100%;margin:0;padding:0;display:flex;outline:none!important}@media (any-hover:hover){.button-PYEOTd6i:hover:not(.disabled-PYEOTd6i){background-color:var(--themed-color-button-hover,#f2f2f2)}html.theme-dark .button-PYEOTd6i:hover:not(.disabled-PYEOTd6i){background-color:var(--themed-color-button-hover,#3d3d3d)}}.button-PYEOTd6i.hidden-PYEOTd6i{display:none}.icon-PYEOTd6i{flex:none;justify-content:center;align-items:center;transition:transform .35s;display:flex}.icon-PYEOTd6i.dropped-PYEOTd6i{transform:rotate(180deg)}"
